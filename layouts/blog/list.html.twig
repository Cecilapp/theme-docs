{% extends ['list.html.twig', '_default/list.html.twig'] %}

      {%- block article ~%}
      <div class="flex">
        <div class="container mx-auto px-4 py-6">
          {{- include('partials/breadcrumb.html.twig') ~}}
          <section id="content" class="markdown markdown-theme max-w-none">
            {%- block content ~%}
            <h1>{{ page.title }}</h1>
            {%- if page.content %}{{ page.content }}{% endif ~%}
            {%- endblock content ~%}
          </section>
          <div class="py-6">
            <nav class="grid grid-cols-1 gap-8">
              {%- for p in pages ~%}
              <a href="{{ url(p) }}" class="hover:no-underline text-inherit dark:text-inherit">
                <section class="px-6 py-6 rounded-xl border border-secondary-200 shadow-md hover:border-primary-700 dark:hover:border-primary-400 h-full">
                  <div class="text-sm">{{ p.date|format_date('long') }}</div>
                  <h2 class="mt-1 font-semibold text-lg">{{ p.title }}</h2>
                  {#- description from front matter, or excerpt of the content ~#}
                  <div class="mt-2 text-secondary-600 dark:text-secondary-400 font-normal">{{ p.description is defined and p.description is not empty ? p.description : p.content|excerpt_html }}</div>
                </section>
              </a>
              {%- endfor ~%}
            </nav>
          </div>
        </div>
      </div>
      {%- endblock article ~%}
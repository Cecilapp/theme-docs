{% extends ['list.html.twig', '_default/list.html.twig'] %}

      {%- block article ~%}
      <div class="flex">
        <div class="container mx-auto px-4 py-6">
          {{- include('partials/breadcrumb.html.twig') ~}}
          <section id="content" class="markdown markdown-theme max-w-none">
            {%- block content ~%}
            <h1>{{ page.title }}</h1>
            {%- if page.content %}{{ page.content }}{% endif ~%}
            {%- endblock content ~%}
          </section>
          {#- feed link ~#}
          {%- for alternate in page.alternates|default([]) ~%}
          {%- if alternate.format in ['atom', 'rss'] ~%}
          <a href="{{ url(page, {format: alternate.format}) }}" type="{{ alternate.type }}" class="mt-2 inline-flex items-center gap-1 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" /></svg>
            {%- trans %}Subscribe to the feed{% endtrans ~%}
          </a>
          {%- endif ~%}
          {%- endfor ~%}
          <div class="py-6">
            <div class="grid grid-cols-1 gap-8">
              {%- for p in pages ~%}
              {#- the whole card is clickable (stretched title link), tags are above it ~#}
              <article class="relative px-6 py-6 rounded-xl border border-secondary-200 dark:border-secondary-700 shadow-md hover:border-primary-700 dark:hover:border-primary-400 h-full">
                <div class="text-sm"><time datetime="{{ p.date|date('c') }}">{{ p.date|format_date('long') }}</time></div>
                <h2 class="mt-1 font-semibold text-lg"><a href="{{ url(p) }}" class="hover:no-underline text-inherit dark:text-inherit after:absolute after:inset-0">{{ p.title }}</a></h2>
                {#- description from front matter, or excerpt of the content ~#}
                <div class="mt-2 text-secondary-600 dark:text-secondary-400 font-normal">{{ p.description is defined and p.description is not empty ? p.description : p.content|excerpt_html }}</div>
                {%- if p.tags|default ~%}
                <div class="mt-3">
                  {{- include('partials/tags.html.twig', {p: p}) ~}}
                </div>
                {%- endif ~%}
              </article>
              {%- endfor ~%}
            </div>
            {{- include('partials/paginator.html.twig') ~}}
          </div>
        </div>
      </div>
      {%- endblock article ~%}

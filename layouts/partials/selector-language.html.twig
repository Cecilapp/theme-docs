          {#- language selector: a disclosure of links (navigating on a `<select>` change is not accessible) ~#}
          {%- if page.translations|length >= 1 ~%}
          {%- set languages = [page]|merge(page.translations|filter(p => p.language is defined))|sort((a, b) => a.language <=> b.language) ~%}
          <details class="dropdown{% if label ?? false %} dropdown-inline{% endif %}">
            <summary>
              <span{% if (label ?? false) != true %} class="sr-only"{% endif %}>{% trans %}Language:{% endtrans %}</span>
              <span>{{ page.language|language_name(site.language.locale(page.language))|capitalize }}</span>
              <svg class="chevron" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </summary>
            <ul>
            {%- for p in languages ~%}
              <li><a href="{{ url(p) }}" hreflang="{{ p.language }}" lang="{{ p.language }}" data-language="{{ p.language }}"{% if p.language == page.language %} aria-current="page"{% endif %}>{{ p.language|language_name(site.language.locale(p.language))|capitalize }}</a></li>
            {%- endfor ~%}
            </ul>
          </details>
          {%- if site.language_cookie ?? false ~%}
          <script>{% apply minify_js ~%}
            (function () {
              if (window.languageCookieInit) return;
              window.languageCookieInit = true;
              {# stores the selected language (e.g. for Netlify `nf_lang` redirects) #}
              document.addEventListener('click', function (e) {
                const link = e.target.closest('.dropdown a[data-language]');
                if (link) {
                  document.cookie = '{{ site.language_cookie|e('js') }}=' + link.dataset.language + '; path=/; max-age=31536000; SameSite=Lax';
                }
              });
            })();
          {% endapply %}</script>
          {%- endif ~%}
          {%- endif ~%}

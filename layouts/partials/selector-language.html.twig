          {#- language selector ~#}
          {%- if page.translations|length >= 1 ~%}
          <form class="formselect">
            <label{% if (label ?? false) != true %} class="sr-only"{% endif %} for="lang-select{% if id ?? false %}-{{ id }}{% endif %}">{% trans %}Language:{% endtrans %}</label>
            <select id="lang-select{% if id ?? false %}-{{ id }}{% endif %}" onchange="switchLanguage(this)" class="selector selector-lang text-ellipsis focus:outline-none">
              <option value="{{ url(page) }}" data-language="{{ page.language }}" selected>{{ page.language|language_name(site.language.locale(page.language))|capitalize }}</option>
            {%- for p in page.translations ~%}
              {%- if p.language is defined ~%}
              <option value="{{ url(p) }}" data-language="{{ p.language }}">{{ p.language|language_name(site.language.locale(p.language))|capitalize }}</option>
              {%- endif ~%}
            {%- endfor ~%}
            </select>
          </form>
          <script>{% apply minify_js ~%}
            window.switchLanguage = window.switchLanguage || function (select) {
              const option = select.options[select.selectedIndex];
              {%- if site.language_cookie ?? false %}
              {# stores the selected language (e.g. for Netlify `nf_lang` redirects) #}
              document.cookie = '{{ site.language_cookie|e('js') }}=' + option.dataset.language + '; path=/; max-age=31536000; SameSite=Lax';
              {%- endif %}
              window.location.href = option.value;
            };
          {% endapply %}</script>
          {%- endif ~%}

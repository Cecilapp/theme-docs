        {#- features ~#}
        {%- if block.features|default ~%}
        <section id="{{ block.name }}" class="container mx-auto px-4 py-6">
          <h2 class="sr-only">{% trans %}Features{% endtrans %}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            {%- for feature in block.features ~%}
              {{- include('partials/feature.html.twig') ~}}
            {%- endfor ~%}
          </div>
        </section>
        {%- endif ~%}
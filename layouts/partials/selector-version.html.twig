          {#- version selector: links to the documentation versions (`versions` option), the current one is `version` (or the first one) ~#}
          {%- if site.versions|default ~%}
          {%- set current = site.version|default(site.versions|first.name) ~%}
          <details class="dropdown{% if label ?? false %} dropdown-inline{% else %} dropdown-start{% endif %}">
            <summary>
              <span{% if (label ?? false) != true %} class="sr-only"{% endif %}>{% trans %}Version:{% endtrans %}</span>
              <span>{{ current }}</span>
              <svg class="chevron" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </summary>
            <ul>
            {%- for version in site.versions ~%}
              <li><a href="{{ url(version.url|default('/')) }}"{% if version.name == current %} aria-current="true"{% endif %}>{{ version.name }}</a></li>
            {%- endfor ~%}
            </ul>
          </details>
          {%- endif ~%}

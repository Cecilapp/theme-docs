    {#- sidebar ~#}
    <div id="sidebar" data-showlarge="{{ showlarge ? 'true' : 'false' }}" class="flex flex-col fixed z-50 lg:z-0 top-0 lg:top-auto w-80 lg:max-w-72 h-screen overflow-auto bg-primary-100 dark:bg-primary-900 shadow-md lg:shadow-none -translate-x-full {% if showlarge %}lg:translate-x-0{% endif %} transition-all duration-200 ease-out">
      <div class="lg:hidden flex items-center h-header pl-4 py-3">
        {#- sidebar mobile button ~#}
        <button id="sidebar-close-button" type="button" class="navbar-item flex lg:hidden items-center mr-3 cursor-pointer" onclick="toggleMenu()" aria-controls="sidebar" aria-label="{% trans %}Close menu{% endtrans %}" title="{% trans %}Close menu{% endtrans %}">
          <svg id="sidebar-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        {#- logo ~#}
        {{- include('partials/logo.html.twig') ~}}
      </div>
      <nav class="px-4 divide-y divide-secondary-400 lg:divide-y-0" aria-label="{% trans %}Navigation{% endtrans %}">
        {#- main navigation ~#}
        {%- block navigation %}{% endblock navigation ~%}
        {#- main menu ~#}
        <div class="flex lg:hidden py-2">
          <ol class="w-full">
            {{- include('partials/menu.html.twig') ~}}
          </ol>
        </div>
        {#- language selector ~#}
        <div class="lg:hidden py-2">
          {{- include('partials/selector-language.html.twig', {'label': true}) ~}}
        </div>
      </nav>
      <div class="grow lg:grow-0"></div>
      <footer class="my-4 text-sm text-center text-secondary-800 dark:text-secondary-300 font-thin">
        {% trans with {'%powered_by%': '<a href="' ~ cecil.url ~ '">Cecil</a>'} %}Powered by %powered_by%{% endtrans ~%}
      </footer>
    </div>
    <div id="sidebar-cloudywrapper" class="hidden lg:hidden fixed top-0 z-40 w-full h-full bg-black opacity-50" onclick="toggleMenu()"></div>
    <script>{% apply minify_js ~%}
      (function () {
        const sidebar = document.getElementById('sidebar');
        const wrapper = document.getElementById('sidebar-cloudywrapper');
        const large = window.matchMedia('(min-width: 64rem)');
        function isOpen() {
          return !sidebar.classList.contains('-translate-x-full');
        }
        {# off-canvas sidebar must not be focusable when hidden #}
        function updateInert() {
          sidebar.inert = !isOpen() && !(large.matches && sidebar.dataset.showlarge === 'true');
        }
        window.toggleMenu = function (open) {
          open = typeof open === 'boolean' ? open : !isOpen();
          sidebar.classList.toggle('-translate-x-full', !open);
          wrapper.classList.toggle('hidden', !open);
          updateInert();
          const openButton = document.getElementById('sidebar-open-button');
          if (openButton) {
            openButton.setAttribute('aria-expanded', open ? 'true' : 'false');
          }
          if (open) {
            document.getElementById('sidebar-close-button').focus();
          } else if (openButton && sidebar.contains(document.activeElement)) {
            openButton.focus();
          }
        };
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && isOpen() && !large.matches) {
            toggleMenu(false);
          }
        });
        large.addEventListener('change', updateInert);
        updateInert();
        {# scroll the sidebar to the current page link #}
        const active = sidebar.querySelector('a[aria-current="page"]');
        if (active) {
          const offset = active.getBoundingClientRect().top - sidebar.getBoundingClientRect().top;
          if (offset > sidebar.clientHeight - 50) {
            sidebar.scrollTop = offset - sidebar.clientHeight / 2;
          }
        }
      })();
    {% endapply %}</script>

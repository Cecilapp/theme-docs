{% extends 'docs/page.html.twig' %}

                {%- block content ~%}
                {%- if '<h1' not in page.content ~%}
                <h1>{{ page.title }}</h1>
                {%- endif ~%}
                {{ page.content }}
                {%- endblock content ~%}

              {#- sub-sections and pages of the section ~#}
              {%- block after_content ~%}
              {%- set children = [] ~%}
              {%- for s in page.sections ~%}
                {%- set children = children|merge([s]) ~%}
              {%- endfor ~%}
              {%- for p in page.pages.showable ~%}
                {%- if p.type != 'section' and p.parent and p.parent.id == page.id ~%}
                {%- set children = children|merge([p]) ~%}
                {%- endif ~%}
              {%- endfor ~%}
              {%- if children is not empty ~%}
              <nav class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4" aria-label="{{ page.title }}">
                {%- for child in children|sort_by_weight ~%}
                <a href="{{ url(child) }}" class="block px-5 py-4 rounded-xl border border-secondary-200 dark:border-secondary-700 shadow-md hover:border-primary-700 dark:hover:border-primary-400 hover:no-underline text-inherit dark:text-inherit">
                  <h2 class="font-semibold text-lg mb-1">{{ child.title }}</h2>
                  {%- if child.description|default ~%}
                  <p class="text-secondary-600 dark:text-secondary-400 font-normal">{{ child.description }}</p>
                  {%- endif ~%}
                </a>
                {%- endfor ~%}
              </nav>
              {%- endif ~%}
              {%- endblock after_content ~%}

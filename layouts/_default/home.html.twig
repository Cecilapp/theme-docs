{% extends '_default/page.html.twig' %}

    {%- block article ~%}
      <div class="flex-col">
        {#- blocks ~#}
        {%- for block in page.blocks|default ~%}
        {{- include('partials/blocks/' ~ block.name ~ '.html.twig', ignore_missing = true) ~}}
        {%- endfor ~%}
        {#- content ~#}
        {%- if page.content ~%}
        <div class="container mx-auto px-6 py-6">
          <article id="content" class="markdown markdown-theme max-w-none">
            {%- block content ~%}
            {{ page.content }}
            {%- endblock content ~%}
          </article>
        </div>
        {%- endif ~%}
      </div>
    {%- endblock article ~%}
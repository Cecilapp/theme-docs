<!DOCTYPE html>
<html lang="{{ site.language }}" class="scroll-pt-[70px] scroll-smooth lg:overflow-y-scroll">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    {#- apply dark theme before first paint (avoids flash of light theme) ~#}
    <script>{% apply minify_js ~%}
      try {
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
          document.documentElement.dataset.theme = 'dark';
        }
      } catch (e) {}
    {% endapply %}</script>
    {{- include('partials/metatags.html.twig') ~}}
    {%- set styles = ['https://cdnjs.cloudflare.com/ajax/libs/highlight.js/' ~ site.highlightjs.version ~ '/styles/github-dark.min.css'] ~%}
    {#- DocSearch component theme (https://github.com/Cecilapp/theme-docsearch) ~#}
    {%- set docsearch = (site.docsearch.enabled ?? false) and site.docsearch.appId|default ~%}
    {%- if docsearch ~%}
    {{- include('partials/docsearch/head.html.twig', ignore_missing = true) ~}}
    {%- elseif site.flexsearch.enabled ?? false ~%}
    {#- FlexSearch component theme (https://github.com/Cecilapp/theme-flexsearch) ~#}
    {%- set styles = styles|merge(['flexsearch/flexsearch.css']) ~%}
    {%- endif ~%}
    {%- block styles %}{% endblock ~%}
    {%- set styles = styles|merge(['styles.css']) ~%}
    {#- stylesheets added by a child template, kept out of the main bundle (`styles_extra` must be set outside of any block) and loaded before it so the theme can override them ~#}
    {%- set styles_extra = styles_extra ?? [] ~%}
    {%- if getenv('CECIL_ENV') == 'production' ~%}
    {%- for style in styles_extra ~%}
    <style>{{ asset(style)|inline }}</style>
    {%- endfor ~%}
    <style>{{ asset(styles)|inline }}</style>
    {%- else ~%}
    {%- for style in styles_extra ~%}
    {{ html(asset(style)) }}
    {%- endfor ~%}
    {{ html(asset(styles)) }}
    {%- endif ~%}
    {{- include('partials/pwa.html.twig', {site}, with_context = false, ignore_missing: true) ~}}
  </head>
  <body class="font-sans antialiased bg-primary-50 dark:bg-primary-950 text-[#050505] dark:text-secondary-100">
    {#- AI agents info ~#}
    {%- if 'llms' in site.output.pagetypeformats.homepage ?? [] ~%}
    <div class="hidden" aria-hidden="true">
      For AI agents: visit {{ url('llms.txt', {canonical: true}) }} for an index of all pages formatted in Markdown and endpoints in OpenAPI.
      {%- if 'markdown' in site.output.pagetypeformats.page ?? [] %} Append .md to any documentation page URL to get its markdown version.{%- endif ~%}
    </div>
    {%- endif ~%}
    {#- skip link ~#}
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-60 focus:px-4 focus:py-2 focus:rounded-md focus:bg-primary-50 dark:focus:bg-primary-950 focus:text-primary-700 dark:focus:text-primary-400 focus:font-semibold focus:shadow-md">{% trans %}Skip to content{% endtrans %}</a>
    {#- sidebar ~#}
    {%- block sidebar ~%}
      {%- embed 'partials/sidebar.html.twig' with {'showlarge': false} %}{% endembed ~%}
    {%- endblock sidebar ~%}
    <header class="fixed top-0 inset-x-0 z-30 flex items-center h-14 bg-primary-700 dark:bg-primary-900 shadow-md">
      <nav class="flex items-center w-full px-4">
        {#- sidebar mobile button ~#}
        <button id="sidebar-open-button" type="button" class="navbar-item flex lg:hidden items-center mr-3 cursor-pointer" onclick="toggleMenu()" aria-controls="sidebar" aria-expanded="false" aria-label="{% trans %}Open menu{% endtrans %}" title="{% trans %}Open menu{% endtrans %}">
          <svg id="sidebar-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
        {#- logo ~#}
        {{- include('partials/logo.html.twig') ~}}
        <div class="grow"></div>
        {#- main menu ~#}
        <div class="hidden lg:flex ml-4 items-center">
          <ol class="flex space-x-4">
            {{- include('partials/menu.html.twig') ~}}
          </ol>
        </div>
        {#- DocSearch button ~#}
        {%- if docsearch ~%}
        <div class="md:inline-block ml-4 py-2">
          {{- include('partials/docsearch/button.html.twig', ignore_missing = true) ~}}
        </div>
        {#- FlexSearch trigger ~#}
        {%- elseif site.flexsearch.enabled ?? false ~%}
        <div class="ml-4 py-2 flex items-center">
          {{- include('partials/flexsearch/trigger.html.twig') ~}}
        </div>
        {%- endif ~%}
        {#- theme selector ~#}
        <div class="navbar-item ml-4 py-2 pt-3.5">
          {{- include('partials/selector-theme-icon.html.twig') ~}}
        </div>
        {#- GitHub link ~#}
        {%- if site.github.url|default ~%}
        <a href="{{ site.github.url }}" title="{% trans with {'%title%': site.title} %}%title% on GitHub{% endtrans %}" class="navbar-item flex no-underline hover:no-underline ml-4 py-2 items-center" rel="noopener noreferrer">
          <svg class="fill-current text-inherit hover:text-inherit w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 20 20">
            <title>{% trans with {'%title%': site.title} %}%title% on GitHub{% endtrans %}</title>
            <path d="M10 0a10 10 0 0 0-3.16 19.49c.5.1.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.1.39-1.99 1.03-2.69a3.6 3.6 0 0 1 .1-2.64s.84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.4.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85l-.01 2.75c0 .26.18.58.69.48A10 10 0 0 0 10 0"></path>
          </svg>
        </a>
        {%- endif ~%}
        {#- language selector ~#}
        {%- if page.translations|length >= 1 ~%}
        <div class="navbar-item ml-4 hidden sm:flex">
          {{- include('partials/selector-language.html.twig') ~}}
        </div>
        {%- endif ~%}
      </nav>
    </header>
    <main id="main" tabindex="-1" class="h-full mt-14 focus:outline-none">
      {%- block article ~%}
      <div class="container mx-auto px-4 py-6">
        {{- include('partials/breadcrumb.html.twig') ~}}
        <article id="content" class="markdown markdown-theme max-w-none">
          {%- block content ~%}
          {{ page.content }}
          {%- endblock content ~%}
        </article>
      </div>
      {%- endblock article ~%}
      <div id="button-top" class="fixed bottom-0 mb-4 right-0 mr-4 z-10 opacity-0 invisible transition-all duration-150 ease-in-out">
        <a href="#main" class="rounded-full border-0 flex items-center justify-center w-10 h-10 bg-primary-700 dark:bg-primary-900 text-primary-100 hover:text-primary-50 shadow-md" aria-label="{% trans %}Back to top{% endtrans %}" title="{% trans %}Back to top{% endtrans %}">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
          </svg>
        </a>
      </div>
      <script>{% apply minify_js ~%}
        {# scroll top #}
        (function () {
          const buttonTop = document.getElementById('button-top');
          function toggleButtonTop() {
            const hide = window.scrollY <= 300;
            buttonTop.classList.toggle('opacity-0', hide);
            buttonTop.classList.toggle('invisible', hide);
          }
          window.addEventListener('scroll', toggleButtonTop, {passive: true});
          toggleButtonTop();
        })();
        {# copy code button #}
        (function () {
          if (!navigator.clipboard) return;
          const labelCopy = '{{ 'Copy code'|trans|e('js') }}';
          const labelCopied = '{{ 'Copied!'|trans|e('js') }}';
          document.querySelectorAll('#content pre > code:not(.language-mermaid)').forEach((code) => {
            const pre = code.parentElement;
            const wrapper = document.createElement('div');
            wrapper.className = 'code-block';
            pre.parentNode.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'copy-code';
            button.setAttribute('aria-live', 'polite');
            button.textContent = labelCopy;
            button.addEventListener('click', () => {
              navigator.clipboard.writeText(code.innerText.replace(/\n$/, '')).then(() => {
                button.textContent = labelCopied;
                setTimeout(() => { button.textContent = labelCopy; }, 2000);
              });
            });
            wrapper.appendChild(button);
          });
        })();
      {% endapply %}</script>
    </main>
    <footer id="footer" class="mx-4 p-4 text-sm text-center flex flex-col justify-center gap-2">
      <div class="container mx-auto flex flex-col items-center gap-2">
        {%- if site.menus.footer is defined ~%}
        <nav aria-label="{% trans %}Footer{% endtrans %}">
          <ul class="flex flex-row flex-wrap justify-center gap-x-4 gap-y-1">
          {%- for entry in site.menus.footer|sort_by_weight ~%}
            <li>
              <a href="{{ url(entry) }}" class="font-semibold">{{ entry.name }}</a>
            </li>
          {%- endfor ~%}
          </ul>
        </nav>
        {%- endif ~%}
        <div>{{ site.footer|replace({'%author%': site.author.name|default(site.title)}) }}</div>
        {%- block footer ~%}{%- endblock footer ~%}
        <a href="{{ cecil.url }}" title="{% trans with {'%powered_by%': 'Cecil'} %}Powered by %powered_by%{% endtrans %}"><img src="{{ url(asset('logo-cecil.svg')) }}" class="w-8 h-8 mx-auto" alt="{% trans with {'%powered_by%': 'Cecil'} %}Powered by %powered_by%{% endtrans %}" /></a>
      </div>
    </footer>
    {%- block scripts ~%}
    {%- if docsearch ~%}
    {{ include('partials/docsearch/script.html.twig', ignore_missing = true) }}
    {%- elseif site.flexsearch.enabled ?? false ~%}
    {{ include('partials/flexsearch/dialog.html.twig') }}
    {%- endif ~%}
    {%- endblock scripts ~%}
  </body>
</html>
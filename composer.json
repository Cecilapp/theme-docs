{
  "name": "cecil/theme-docs",
  "type": "cecil-theme",
  "description": "Cecil theme Docs",
  "keywords": ["Cecil", "theme", "documentation"],
  "license": "MIT",
  "require": {
    "cecil/theme-installer": "^1.0||^2.0"
  },
  "require-dev": {
    "aligny/tailwind-builder": "^1.0"
  },
  "scripts": {
    "css:build": "tailwind-builder ./assets/css/tailwind.css --output=./assets/styles.css --minify",
    "css:watch": "tailwind-builder ./assets/css/tailwind.css --output=./assets/styles.css --watch"
  },
  "extra": {
    "name": "docs",
    "branch-alias": {
      "dev-master": "2.x-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "cecil/theme-installer": true
    }
  }
}
